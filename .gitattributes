# Line endings
*                 text=auto eol=lf
*.java            text eol=crlf
*.md              text eol=lf
*.xml             text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.csv             text eol=lf
*.ini             text eol=lf
*.json            text eol=lf
*.txt             text eol=lf
LICENSE           text eol=lf

# Binary
*.jar             binary
*.class           binary

# Linguist hints
target/           linguist-generated=true
*.iml             linguist-vendored
.idea/            linguist-vendored
.zcode/           linguist-vendored
.codemoss/        linguist-vendored
graphify-out/     linguist-vendored
docs/code-review-findings.md linguist-documentation=false
